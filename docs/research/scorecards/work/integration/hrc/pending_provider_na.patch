+def test_printed_na_rating_is_preserved_without_adding_a_slash():
+    # HRC physical page20 prints NA for Foushee's116th score, alongside N/A.
+    result = _house_with_vacancy()
+    result["vacant_seats"] = []
+    result["members"][0]["ratings"][2]["value_text"] = "NA"
+    original = deepcopy(result)
+    validate_outcome(20, result)
+    assert result == original
+
+
+@pytest.mark.parametrize("value", ["N / A", "NA?", "N/A?"])
+def test_unqualified_rating_text_still_refuses(value):
+    result = _house_with_vacancy()
+    result["vacant_seats"] = []
+    result["members"][0]["ratings"][2]["value_text"] = value
+    with pytest.raises(ValueError, match="published rating"):
+        validate_outcome(20, result)
