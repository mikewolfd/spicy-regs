    "attributed_ratings": {
      "sql": "SELECT p.name AS publisher,c.title AS scorecard,m.member_name,metrics.name AS metric,r.value_text AS published_value,r.source_url AS publisher_url FROM scorecard_member_ratings r JOIN scorecards c USING(scorecard_id) JOIN scorecard_publishers p USING(publisher_id) JOIN scorecard_metrics metrics ON metrics.scorecard_id=r.scorecard_id AND metrics.metric_id=r.metric_id JOIN scorecard_members m ON m.scorecard_id=r.scorecard_id AND m.publisher_member_key=r.publisher_member_key QUALIFY row_number() OVER(PARTITION BY c.publisher_id ORDER BY m.member_name,r.metric_id)=1 ORDER BY publisher",
      "source": "r2",
      "base_url": "https://data.spicygov.ai",
