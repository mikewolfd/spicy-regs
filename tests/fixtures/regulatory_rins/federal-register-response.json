ulation_id_numbers":[],"signing_date":"2026-08-20","start_page":54935,"subtype":"Determination","title":"Continuation of the Exercise of Certain Authorities Under the Trading With the Enemy Act","topics":[],"type":"Presidential Document","volume":91},{"abstract":null,"agencies":[{"raw_name":"EXECUTIVE OFFICE OF THE PRESIDENT","name":"Executive Office of the President","id":538,"url":"https://www.federalregister.gov/agencies/executive-office-of-the-president","json_url":"https://www.federalregister.gov/api/v1/agencies/538","parent_id":null,"slug":"executive-office-of-the-president"}],"agency_names":["Executive Office of the President"],"body_html_url":"https://www.federalregister.gov/documents/full_text/html/2026/08/25/2026-17372.html","cfr_references":[],"comments_close_on":null,"docket_ids":[],"document_number":"2026-17372","effective_on":null,"end_page":54934,"executive_order_number":null,"full_text_xml_url":"https://www.federalregister.gov/documents/full_text/xml/2026/08/25/2026-17372.xml","html_url":"https://www.federalregister.gov/documents/2026/08/25/2026-17372/the-national-space-transportation-policy","pdf_url":"https://www.govinfo.gov/content/pkg/FR-2026-08-25/pdf/2026-17372.pdf","publication_date":"2026-08-25","regulation_id_numbers":[],"signing_date":"2026-08-20","start_page":54929,"subtype":"Other","title":"The National Space Transportation Policy","topics":[],"type":"Presidential Document","volume":91},{"abstract":"This document sets forth the Commissioner of U.S. Customs and Border Protection's (CBP) declaration establishing four Customs- Enforcement Areas (CEA) in the near shore waters of South Florida, Central/Southern California, Puerto Rico, and the Gulf Coast of Texas. This action will further CBP efforts to interdict hovering vessels utilized for smuggling illegal cargoes into or out of the United States specifically within the CEAs. Additionally, this action authorizes customs officers and agents to enforce applicable U.S. laws, including the authorization to board vessels, examine vessels, merchandise and persons on board, bring the same into port, and pursue, seize, and arrest individuals, within the CEAs.","agencies":[{"raw_name":"DEPARTMENT OF HOMELAND SECURITY","name":"Homeland Security Department","id":227,"url":"https://www.federalregister.gov/agencies/homeland-security-department","json_url":"https://www.federalregister.gov/api/v1/agencies/227","parent_id":null,"slug":"homeland-security-department"},{"raw_name":"U.S. Customs and Border Protection","name":"U.S. Customs and Border Protection","id":501,"url":"https://www.federalregister.gov/agencies/u-s-customs-and-border-protection","json_url":"https://www.federalregister.gov/api/v1/agencies/501","parent_id":227,"slug":"u-s-customs-and-border-protection"}],"agency_names":["Homeland Security Department","U.S. Customs and Border Protection"],"body_html_url":"https://www.federalregister.gov/documents/full_text/html/2026/08/25/2026-17354.html","cfr_references":[{"chapter":"I","citation_url":null,"part":null,"title":19}],"comments_close_on":null,"docket_ids":["CBP Dec. No. 26-17"],"document_number":"2026-17354","effective_on":null,"end_page":54803,"executive_order_number":null,"full_text_xml_url":"https://www.federalregister.gov/documents/full_text/xml/2026/08/25/2026-17354.xml","html_url":"https://www.federalregister.gov/documents/2026/08/25/2026-17354/establishment-of-four-customs-enforcement-areas","pdf_url":"https://www.govinfo.gov/content/pkg/FR-2026-08-25/pdf/2026-17354.pdf","publication_date":"2026-08-25","regulation_id_numbers":[],"signing_date":null,"start_page":54800,"subtype":null,"title":"Establishment of Four Customs-Enforcement Areas","topics":[],"type":"Rule","volume":91},{"abstract":"The Secretary waives the requirements in the Education Department General Administrative Regulations (EDGAR) that generally prohibit project period extensions involving the obligation of additional Federal funds. The final waiver and extension would allow 21 projects under Assistance Listing Number (ALN) 84.362A to receive funding for up to one additional 12-month period, not to exceed September 30, 2027.","agencies":[{"raw_name":"DEPARTMENT OF EDUCATION","name":"Education Department","id":126,"url":"https://www.federalregister.gov/agencies/education-department","json_url":"https://www.federalregister.gov/api/v1/agencies/126","parent_id":null,"slug":"education-department"}],"agency_names":["Education Department"],"body_html_url":"https://www.federalregister.gov/documents/full_text/html/2026/08/25/2026-17353.html","cfr_references":[{"chapter":"II","citation_url":null,"part":null,"title":34}],"comments_close_on":null,"docket_ids":["ED-2026-OESE-2113"],"document_number":"2026-17353","effective_on":"2026-08-25","end_page":54813,"executive_order_number":null,"full_text_xml_url":"https://www.federalregister.gov/documents/full_text/xml/2026/08/25/2026-17353.xml","html_url":"https://www.federalregister.gov/documents/2026/08/25/2026-17353/final-waiver-and-extension-of-the-project-period-with-funding-elementary-and-secondary-education-act","pdf_url":"https://www.govinfo.gov/content/pkg/FR-2026-08-25/pdf/2026-17353.pdf","publication_date":"2026-08-25","regulation_id_numbers":[],"signing_date":null,"start_page":54812,"subtype":null,"title":"Final Waiver and Extension of the Project Period With Funding-Elementary and Secondary Education Act of 1965, as Amended, Title VI, Part B, Native Hawaiian Education","topics":[],"type":"Rule","volume":91},{"abstract":"NASA, as part of its continuing effort to reduce paperwork and respondent burden, under the Paperwork Reduction Act (PRA), invites the general public and other Federal agencies to take this opportunity to comment on proposed and/or continuing information collections.","agencies":[{"raw_name":"NATIONAL AERONAUTICS AND SPACE ADMINISTRATION","name":"National Aeronautics and Space Administration","id":301,"url":"https://www.federalregister.gov/agencies/national-aeronautics-and-space-administration","json_url":"https://www.federalregister.gov/api/v1/agencies/301","parent_id":null,"slug":"national-aeronautics-and-space-administration"}],"agency_names":["National Aeronautics and Space Administration"],"body_html_url":"https://www.federalregister.gov/documents/full_text/html/2026/08/25/2026-17343.html","cfr_references":[],"comments_close_on":"2026-09-24","docket_ids":["NASA Document Number: 26-046"],"document_number":"2026-17343","effective_on":null,"end_page":54890,"executive_order_number":null,"full_text_xml_url":"https://www.federalregister.gov/documents/full_text/xml/2026/08/25/2026-17343.xml","html_url":"https://www.federalregister.gov/documents/2026/08/25/2026-17343/name-of-information-collection-jsc-form-1830-report-of-medical-examination","pdf_url":"https://www.govinfo.gov/content/pkg/FR-2026-08-25/pdf/2026-17343.pdf","publication_date":"2026-08-25","regulation_id_numbers":[],"signing_date":null,"start_page":54889,"subtype":null,"title":"Name of Information Collection: JSC Form 1830 Report of Medical Examination","topics":[],"type":"Notice","volume":91},{"abstract":"The Office of the Secretary of Transportation (OST) announces the next public meeting of the Beautifying Transportation Infrastructure Council (Council) on September 30, 2026. This notice announces the date, time, and location of the virtual meeting, which will be open to the public. The purpose of the Council is to advise the Secretary of Transportation on enhancing the aesthetic value of our Nation's transportation systems.","agencies":[{"raw_name":"DEPARTMENT OF TRANSPORTATION","name":"Transportation Department","id":492,"url":"https://www.federalregister.gov/agencies/transportation-department","json_url":"https://www.federalregister.gov/api/v1/agencies/492","parent_id":null,"slug":"transportation-department"},{"raw_name":"Office of the Secretary"}],"agency_names":["Transportation Department","Office of the Secretary"],"body_html_url":"https://www.federalregister.gov/documents/full_text/html/2026/08/25/2026-17342.html","cfr_references":[],"comments_close_on":null,"docket_ids":[],"document_number":"2026-17342","effective_on":null,"end_page":54916,"executive_order_number":null,"full_text_xml_url":"https://www.federalregister.gov/documents/full_text/xml/2026/08/25/2026-17342.xml","html_url":"https://www.federalregister.gov/documents/2026/08/25/2026-17342/beautifying-transportation-infrastructure-council-public-meeting","pdf_url":"https://www.govinfo.gov/content/pkg/FR-2026-08-25/pdf/2026-17342.pdf","publication_date":"2026-08-25","regulation_id_numbers":[],"signing_date":null,"start_page":54915,"subtype":null,"title":"Beautifying Transportation Infrastructure Council; Public Meeting","topics":[],"type":"Notice","volume":91},{"abstract":"In accordance with the Paperwork Reduction Act of 1995, FMCSA announces its plan to submit the Information Collection Request (ICR) described below to the Office of Management and Budget (OMB) for review and approval and invites public comment. This notice invites comments on the renewal of an approved information collection titled \"Emergency Exemptions Under 49 CFR 390.25,\" (OMB Control No. 2126-007) which is currently due to expire on January 31, 2027.","agencies":[{"raw_name":"DEPARTMENT OF TRANSPORTATION","name":"Transportation Department","id":492,"url":"https://www.federalregister.gov/agencies/transportation-department","json_url":"https://www.federalregister.gov/api/v1/agencies/492","parent_id":null,"slug":"transportation-department"},{"raw_name":"Federal Motor Carrier Safety Administration","name":"Federal Motor Carrier Safety Administration","id":181,"url":"https://www.federalregister.gov/agencies/federal-motor-carrier-safety-administration","json_url":"https://www.federalregister.gov/api/v1/agencies/181","parent_id":492,"slug":"federal-motor-carrier-safety-administration"}],"agency_names":["Transportation Department","Federal Motor Carrier Safety Administration"],"body_html_url":"https://www.federalregister.gov/documents/full_text/html/2026/08/25/2026-17341.html","cfr_references":[],"comments_close_on":"2026-10-26","docket_ids":["Docket No. FMCSA-2026-2476"],"document_number":"2026-17341","effective_on":null,"end_page":54915,"executive_order_number":null,"full_text_xml_url":"https://www.federalregister.gov/documents/full_text/xml/2026/08/25/2026-17341.xml","html_url":"https://www.federalregister.gov/documents/2026/08/25/2026-17341/agency-information-collection-activities-renewal-of-an-approved-information-collection-emergency","pdf_url":"https://www.govinfo.gov/content/pkg/FR-2026-08-25/pdf/2026-17341.pdf","publication_date":"2026-08-25","regulation_id_numbers":[],"signing_date":null,"start_page":54914,"subtype":null,"title":"Agency Information Collection Activities; Renewal of an Approved Information Collection: Emergency Exemptions Under 49 CFR 390.25","topics":[],"type":"Notice","volume":91},{"abstract":"In accordance with the Paperwork Reduction Act of 1995, FMCSA announces its plan to submit the Information Collection Request (ICR) described below to the Office of Management and Budget (OMB) for review and approval and invites public comment. FMCSA requests approval to renew an ICR titled, \"Non-Insulin-Treated Diabetes Mellitus Assessment Form, MCSA-5872.\" This information collection (IC) is voluntary and may be utilized by certified medical examiners (MEs) responsible for issuing Medical Examiner's Certificates (MEC), Form MCSA-5876, to individuals diagnosed with non-insulin-treated diabetes mellitus who operate commercial motor vehicles (CMVs). MEs choosing to use this IC will do so in an effort to communicate with treating healthcare providers who manage the diabetes care of individuals diagnosed with non-insulin-treated diabetes mellitus who operate CMVs. The information obtained by MEs will assist them in determining if an individual diagnosed with non-insulin-treated diabetes mellitus meets FMCSA's physical qualification standards.","agencies":[{"raw_name":"DEPARTMENT OF TRANSPORTATION","name":"Transportation Department","id":492,"url":"https://www.federalregister.gov/agencies/transportation-department","json_url":"https://www.federalregister.gov/api/v1/agencies/492","parent_id":null,"slug":"transportation-department"},{"raw_name":"Federal Motor Carrier Safety Administration","name":"Federal Motor Carrier Safety Administration","id":181,"url":"https://www.federalregister.gov/agencies/federal-motor-carrier-safety-administration","json_url":"https://www.federalregister.gov/api/v1/agencies/181","parent_id":492,"slug":"federal-motor-carrier-safety-administration"}],"agency_names":["Transportation Department","Federal Motor Carrier Safety Administration"],"body_html_url":"https://www.federalregister.gov/documents/full_text/html/2026/08/25/2026-17340.html","cfr_references":[],"comments_close_on":"2026-10-26","docket_ids":["Docket No. FMCSA-2026-1783"],"document_number":"2026-17340","effective_on":null,"end_page":54914,"executive_order_number":null,"full_text_xml_url":"https://www.federalregister.gov/documents/full_text/xml/2026/08/25/2026-17340.xml","html_url":"https://www.federalregister.gov/documents/2026/08/25/2026-17340/agency-information-collection-activities-renewal-of-an-approved-information-collection","pdf_url":"https://www.govinfo.gov/content/pkg/FR-2026-08-25/pdf/2026-17340.pdf","publication_date":"2026-08-25","regulation_id_numbers":[],"signing_date":null,"start_page":54912,"subtype":null,"title":"Agency Information Collection Activities; Renewal of an Approved Information Collection: Non-Insulin-Treated Diabetes Mellitus Assessment Form, MCSA-5872","topics":[],"type":"Notice","volume":91},{"abstract":"This action amends multiple coordinates used to describe restricted areas R-2505, R-2524, R-2508, and R-2515 in California. The amendments are administrative in nature and do not expand any outer boundaries, altitudes, times of designation, or activities conducted within the restricted areas.","agencies":[{"raw_name":"DEPARTMENT OF TRANSPORTATION","name":"Transportation Department","id":492,"url":"https://www.federalregister.gov/agencies/transportation-department","json_url":"https://www.federalregister.gov/api/v1/agencies/492","parent_id":null,"slug":"transportation-department"},{"raw_name":"Federal Aviation Administration","name":"Federal Aviation Administration","id":159,"url":"https://www.federalregister.gov/agencies/federal-aviation-administration","json_url":"https://www.federalregister.gov/api/v1/agencies/159","parent_id":492,"slug":"federal-aviation-administration"}],"agency_names":["Transportation Department","Federal Aviation Administration"],"body_html_url":"https://www.federalregister.gov/documents/full_text/html/2026/08/25/2026-17339.html","cfr_references":[{"chapter":null,"citation_url":null,"part":"73","title":14}],"comments_close_on":null,"docket_ids":["Docket No. FAA-2026-10430","Airspace Docket No. 25-AWP-168"],"document_number":"2026-17339","effective_on":"2026-10-29","end_page":54800,"executive_order_number":null,"full_text_xml_url":"https://www.federalregister.gov/documents/full_text/xml/2026/08/25/2026-17339.xml","html_url":"https://www.federalregister.gov/documents/2026/08/25/2026-17339/amendment-of-restricted-areas-r-2505-r-2524-r-2508-and-r-2515-in-california","pdf_url":"https://www.govinfo.gov/content/pkg/FR-2026-08-25/pdf/2026-17339.pdf","publication_date":"2026-08-25","regulation_id_numbers":["2120-AA66"],"signing_date":null,"start_page":54798,"subtype":null,"title":"Amendment of Restricted Areas R-2505, R-2524, R-2508, and R-2515 in California","topics":["Airspace"],"type":"Rule","volume":91},{"abstract":"The Office of Personnel Management (OPM) published a final rule in the Federal Register on August 3, 2026, concerning reduction in force appeals. That document contained typographical and citation errors in the regulatory text. This document corrects the final rule.","agencies":[{"raw_name":"OFFICE OF PERSONNEL MANAGEMENT","name":"Personnel Management Office","id":406,"url":"https://www.federalregister.gov/agencies/personnel-management-office","json_url":"https://www.federalregister.gov/api/v1/agencies/406","parent_id":null,"slug":"personnel-management-office"}],"agency_names":["Personnel Management Office"],"body_html_url":"https://www.federalregister.gov/documents/full_text/html/2026/08/25/2026-17338.html","cfr_references":[{"chapter":null,"citation_url":null,"part":"351","title":5}],"comments_close_on":null,"docket_ids":["Docket ID: OPM-2025-0239"],"document_number":"2026-17338","effective_on":"2026-09-02","end_page":54796,"executive_order_number":null,"full_text_xml_url":"https://www.federalregister.gov/documents/full_text/xml/2026/08/25/2026-17338.xml","html_url":"https://www.federalregister.gov/documents/2026/08/25/2026-17338/reduction-in-force-appeals-correction","pdf_url":"https://www.govinfo.gov/content/pkg/FR-2026-08-25/pdf/2026-17338.pdf","publication_date":"2026-08-25","regulation_id_numbers":["3206-AO99"],"signing_date":null,"start_page":54796,"subtype":null,"title":"Reduction in Force Appeals; Correction","topics":[],"type":"Rule","volume":91},{"abstract":"The Office of Personnel Management (OPM) published a final rule in the Federal Register on August 3, 2026, concerning suitability action appeals. That document contained typographical and structural errors in the regulatory text. This document corrects the final rule.","agencies":[{"raw_name":"OFFICE OF PERSONNEL MANAGEMENT","name":"Personnel Management Office","id":406,"url":"https://www.federalregister.gov/agencies/personnel-management-office","json_url":"https://www.federalregister.gov/api/v1/agencies/406","parent_id":null,"slug":"personnel-management-office"}],"agency_names":["Personnel Management Office"],"body_html_url":"https://www.federalregister.gov/documents/full_text/html/2026/08/25/2026-17337.html","cfr_references":[{"chapter":null,"citation_url":null,"part":"731","title":5}],"comments_close_on":null,"docket_ids":["Docket ID: OPM-2025-0173"],"document_number":"2026-17337","effective_on":"2026-09-02","end_page":54798,"executive_order_number":null,"full_text_xml_url":"https://www.federalregister.gov/documents/full_text/xml/2026/08/25/2026-17337.xml","html_url":"https://www.federalregister.gov/documents/2026/08/25/2026-17337/suitability-action-appeals-correction","pdf_url":"https://www.govinfo.gov/content/pkg/FR-2026-08-25/pdf/2026-17337.pdf","publication_date":"2026-08-25","regulation_id_numbers":["3206-AO97"],"signing_date":null,"start_page":54798,"subtype":null,"title":"Suitability Action Appeals; Correction","topics":[],"type":"Rule","volume":91},{"abstract":"The Office of Personnel Management (OPM) published a final rule in the Federal Register on August 3, 2026, streamlining probationary and trial period appeals. That document contained typographical and clerical errors in the regulatory text. This document corrects the final rule. This document also makes a technical amendment to OPM regulations to conform its appeal-rights reference to the final rule.","agencies":[{"raw_name":"OFFICE OF PERSONNEL MANAGEMENT","name":"Personnel Management Office","id":406,"url":"https://www.federalregister.gov/agencies/personnel-management-office","json_url":"https://www.federalregister.gov/api/v1/agencies/406","parent_id":null,"slug":"personnel-management-office"}],"agency_names":["Personnel Management Office"],"body_html_url":"https://www.federalregister.gov/documents/full_text/html/2026/08/25/2026-17336.html","cfr_references":[{"chapter":null,"citation_url":null,"part":"315","title":5},{"chapter":null,"citation_url":null,"part":"751","title":5}],"comments_close_on":null,"docket_ids":["Docket ID: OPM-2025-0013"],"document_number":"2026-17336","effective_on":"2026-09-02","end_page":54794,"executive_order_number":null,"full_text_xml_url":"https://www.federalregister.gov/documents/full_text/xml/2026/08/25/2026-17336.xml","html_url":"https://www.federalregister.gov/documents/2026/08/25/2026-17336/streamlining-probationary-and-trial-period-appeals-correction-and-technical-amendment","pdf_url":"https://www.govinfo.gov/content/pkg/FR-2026-08-25/pdf/2026-17336.pdf","publication_date":"2026-08-25","regulation_id_numbers":["3206-AO96"],"signing_date":null,"start_page":54793,"subtype":null,"title":"Streamlining Probationary and Trial Period Appeals; Correction and Technical Amendment","topics":["Government employees"],"type":"Rule","volume":91},{"abstract":"The Office of Personnel Management (OPM) published a final rule in the Federal Register on August 3, 2026, concerning reduction in force. That document contained typographical and clerical errors in amendatory instructions and in the regulatory text. This document corrects the final rule.","agencies":[{"raw_name":"OFFICE OF PERSONNEL MANAGEMENT","name":"Personnel Management Office","id":406,"url":"https://www.federalregister.gov/agencies/personnel-management-office","json_url":"https://www.federalregister.gov/api/v1/agencies/406","parent_id":null,"slug":"personnel-management-office"}],"agency_names":["Personnel Management Office"],"body_html_url":"https://www.federalregister.gov/documents/full_text/html/2026/08/25/2026-17335.html","cfr_references":[{"chapter":null,"citation_url":null,"part":"316","title":5},{"chapter":null,"citation_url":null,"part":"330","title":5},{"chapter":null,"citation_url":null,"part":"351","title":5},{"chapter":null,"citation_url":null,"part":"353","title":5},{"chapter":null,"citation_url":null,"part":"430","title":5}],"comments_close_on":null,"docket_ids":["Docket ID: OPM-2026-0107"],"document_number":"2026-17335","effective_on":"2026-09-02","end_page":54796,"executive_order_number":null,"full_text_xml_url":"https://www.federalregister.gov/documents/full_text/xml/2026/08/25/2026-17335.xml","html_url":"https://www.federalregister.gov/documents/2026/08/25/2026-17335/reduction-in-force-correction","pdf_url":"https://www.govinfo.gov/content/pkg/FR-2026-08-25/pdf/2026-17335.pdf","publication_date":"2026-08-25","regulation_id_numbers":["3206-AO86"],"signing_date":null,"start_page":54794,"subtype":null,"title":"Reduction in Force; Correction","topics":[],"type":"Rule","volume":91},{"abstract":"The Office of Personnel Management (OPM) is correcting technical and conforming errors arising from two recent final rules: \"Improving Performance, Accountability and Responsiveness in the Civil Service,\" published February 6, 2026 and effective March 9, 2026, and \"Recruitment and Relocation Incentive Waivers,\" published December 15, 2025 and effective February 13, 2026. The corrections make no substantive change to the regulations.","agencies":[{"raw_name":"OFFICE OF PERSONNEL MANAGEMENT","name":"Personnel Management Office","id":406,"url":"https://www.federalregister.gov/agencies/personnel-management-office","json_url":"https://www.federalregister.gov/api/v1/agencies/406","parent_id":null,"slug":"personnel-management-office"}],"agency_names":["Personnel Management Office"],"body_html_url":"https://www.federalregister.gov/documents/full_text/html/2026/08/25/2026-17334.html","cfr_references":[{"chapter":null,"citation_url":null,"part":"575","title":5}],"comments_close_on":null,"docket_ids":["Docket IDs: OPM-2025-0004","OPM-2023-0027"],"document_number":"2026-17334","effective_on":"2026-08-25","end_page":54797,"executive_order_number":null,"full_text_xml_url":"https://www.federalregister.gov/documents/full_text/xml/2026/08/25/2026-17334.xml","html_url":"https://www.federalregister.gov/documents/2026/08/25/2026-17334/improving-performance-accountability-and-responsiveness-in-the-civil-service-and-recruitment-and","pdf_url":"https://www.govinfo.gov/content/pkg/FR-2026-08-25/pdf/2026-17334.pdf","publication_date":"2026-08-25","regulation_id_numbers":["3206-AO36","3206-AO80"],"signing_date":null,"start_page":54796,"subtype":null,"title":"Improving Performance, Accountability and Responsiveness in the Civil Service, and Recruitment and Relocation Incentive Waivers; Correcting Amendments","topics":["Government employees","Wages"],"type":"Rule","volume":91},{"abstract":"We, the Office of Surface Mining Reclamation and Enforcement (OSM), are denying an amendment to the Montana regulatory program under the Surface Mining Control and Reclamation Act of 1977 (SMCRA). Montana submitted this proposed amendment to OSM on its own initiative in response to a State law passed by the Montana Legislature (Senate Bill (SB) 392). The proposed amendment would have added a provision requiring equal application of court costs to the prevailing party in contested case proceedings by a court or administrative agency that issues a decision. The proposal would have also amended the Montana Code Annotated (MCA) to refer to the proposed equal application of court costs rule. Finally, SB 392 includes contingencies that apply to the proposed amendment but are not codified into the MCA: codification instructions, a severability clause, an effective date clause, and an applicability statement.","agencies":[{"raw_name":"DEPARTMENT OF THE INTERIOR","name":"Interior Department","id":253,"url":"https://www.federalregister.gov/agencies/interior-department","json_url":"https://www.federalregister.gov/api/v1/agencies/253","parent_id":null,"slug":"interior-department"},{"raw_name":"Office of Surface Mining Reclamation and Enforcement","name":"Surface Mining Reclamation and Enforcement Office","id":480,"url":"https://www.federalregister.gov/agencies/surface-mining-reclamation-and-enforcement-office","json_url":"https://www.federalregister.gov/api/v1/agencies/480","parent_id":253,"slug":"surface-mining-reclamation-and-enforcement-office"}],"agency_names":["Interior Department","Surface Mining Reclamation and Enforcement Office"],"body_html_url":"https://www.federalregister.gov/documents/full_text/html/2026/08/25/2026-17333.html","cfr_references":[{"chapter":null,"citation_url":null,"part":"926","title":30}],"comments_close_on":null,"docket_ids":["SATS No. MT-043-FOR","Docket No. OSM-2023-0008","S1D1S SS08011000 SX064A000 256S180110","S2D2S SS08011000 SX064A000 25XS501520"],"document_number":"2026-17333","effective_on":"2026-09-24","end_page":54810,"executive_order_number":null,"full_text_xml_url":"https://www.federalregister.gov/documents/full_text/xml/2026/08/25/2026-17333.xml","html_url":"https://www.federalregister.gov/documents/2026/08/25/2026-17333/montana-regulatory-program","pdf_url":"https://www.govinfo.gov/content/pkg/FR-2026-08-25/pdf/2026-17333.pdf","publication_date":"2026-08-25","regulation_id_numbers":[],"signing_date":null,"start_page":54803,"subtype":null,"title":"Montana Regulatory Program","topics":["Intergovernmental relations","Surface mining","Underground mining"],"type":"Rule","volume":91},{"abstract":"The U.S. Department of the Treasury's Office of Foreign Assets Control (OFAC) is publishing the names of one or more persons that have been placed on OFAC's Specially Designated Nationals and Blocked Persons List (SDN List) based on OFAC's determination that one or more applicable legal criteria were satisfied. All property and interests in property subject to U.S. jurisdiction of these persons are blocked, and U.S. persons are generally prohibited from engaging in transactions with them.","agencies":[{"raw_name":"DEPARTMENT OF THE TREASURY","name":"Treasury Department","id":497,"url":"https://www.federalregister.gov/agencies/treasury-department","json_url":"https://www.federalregister.gov/api/v1/agencies/497","parent_id":null,"slug":"treasury-department"},{"raw_name":"Office of Foreign Assets Control","name":"Foreign Assets Control Office","id":203,"url":"https://www.federalregister.gov/agencies/foreign-assets-control-office","json_url":"https://www.federalregister.gov/api/v1/agencies/203","parent_id":497,"slug":"foreign-assets-control-office"}],"agency_names":["Treasury Department","Foreign Assets Control Office"],"body_html_url":"https://www.federalregister.gov/documents/full_text/html/2026/08/25/2026-17332.html","cfr_references":[],"comments_close_on":null,"docket_ids":[],"document_number":"2026-17332","effective_on":null,"end_page":54920,"executive_order_number":null,"full_text_xml_url":"https://www.federalregister.gov/documents/full_text/xml/2026/08/25/2026-17332.xml","html_url":"https://www.federalregister.gov/documents/2026/08/25/2026-17332/notice-of-ofac-sanctions-action","pdf_url":"https://www.govinfo.gov/content/pkg/FR-2026-08-25/pdf/2026-17332.pdf","publication_date":"2026-08-25","regulation_id_numbers":[],"signing_date":null,"start_page":54918,"subtype":null,"title":"Notice of OFAC Sanctions Action","topics":[],"type":"Notice","volume":91},{"abstract":"In accordance with the Paperwork Reduction Act of 1995 (PRA), the Federal Trade Commission (FTC or Commission) is seeking public comment on its proposal to extend for an additional three years the information collection requirements contained in the agency's rule governing Standards for Safeguarding Customer Information (the Safeguards Rule). The current clearance expires on December 31, 2026.","agencies":[{"raw_name":"FEDERAL TRADE COMMISSION","name":"Federal Trade Commission","id":192,"url":"https://www.federalregister.gov/agencies/federal-trade-commission","json_url":"https://www.federalregister.gov/api/v1/agencies/192","parent_id":null,"slug":"federal-trade-commission"}],"agency_names":["Federal Trade Commission"],"body_html_url":"https://www.federalregister.gov/documents/full_text/html/2026/08/25/2026-17331.html","cfr_references":[],"comments_close_on":"2026-10-26","docket_ids":[],"document_number":"2026-17331","effective_on":null,"end_page":54873,"executive_order_number":null,"full_text_xml_url":"https://www.federalregister.gov/documents/full_text/xml/2026/08/25/2026-17331.xml","html_url":"https://www.federalregister.gov/documents/2026/08/25/2026-17331/agency-information-collection-activities-proposed-collection-comment-request-extension","pdf_url":"https://www.govinfo.gov/content/pkg/FR-2026-08-25/pdf/2026-17331.pdf","publication_date":"2026-08-25","regulation_id_numbers":[],"signing_date":null,"start_page":54872,"subtype":null,"title":"Agency Information Collection Activities; Proposed Collection; Comment Request; Extension","topics":[],"type":"Notice","volume":91},{"abstract":"As required by the Paperwork Reduction Act of 1995 (PRA), the Surface Transportation Board (STB or Board) gives notice of its intent to seek approval from the Office of Management and Budget (OMB) for an extension of the collection of the Report of Fuel Cost, Consumption, and Surcharge Revenue, as described below.","agencies":[{"raw_name":"SURFACE TRANSPORTATION BOARD","name":"Surface Transportation Board","id":481,"url":"https://www.federalregister.gov/agencies/surface-transportation-board","json_url":"https://www.federalregister.gov/api/v1/agencies/481","parent_id":null,"slug":"surface-transportation-board"}],"agency_names":["Surface Transportation Board"],"body_html_url":"https://www.federalregister.gov/documents/full_text/html/2026/08/25/2026-17330.html","cfr_references":[],"comments_close_on":"2026-09-24","docket_ids":[],"document_number":"2026-17330","effective_on":null,"end_page":54908,"executive_order_number":null,"full_text_xml_url":"https://www.federalregister.gov/documents/full_text/xml/2026/08/25/2026-17330.xml","html_url":"https://www.federalregister.gov/documents/2026/08/25/2026-17330/30-day-notice-of-intent-to-seek-extension-of-approval-report-of-fuel-cost-consumption-and-surcharge","pdf_url":"https://www.govinfo.gov/content/pkg/FR-2026-08-25/pdf/2026-17330.pdf","publication_date":"2026-08-25","regulation_id_numbers":[],"signing_date":null,"start_page":54908,"subtype":null,"title":"30-Day Notice of Intent To Seek Extension of Approval: Report of Fuel Cost, Consumption, and Surcharge Revenue","topics":[],"type":"Notice","volume":91},{"abstract":"As required by the Paperwork Reduction Act of 1995 (PRA), the Surface Transportation Board (STB or Board) gives notice of its intent to seek approval from the Office of Management and Budget (OMB) for the extension (without change) of the collections required by statute for rail or water carrier equipment liens (recordations), water carrier tariffs, and rail agricultural contract summaries, as described in more detail below.","agencies":[{"raw_name":"SURFACE TRANSPORTATION BOARD","name":"Surface Transportation Board","id":481,"url":"https://www.federalregister.gov/agencies/surface-transportation-board","json_url":"https://www.federalregister.gov/api/v1/agencies/481","parent_id":null,"slug":"surface-transportation-board"}],"agency_names":["Surface Transportation Board"],"body_html_url":"https://www.federalregister.gov/documents/full_text/html/2026/08/25/2026-17329.html","cfr_references":[],"comments_close_on":"2026-09-24","docket_ids":[],"document_number":"2026-17329","effective_on":null,"end_page":54907,"executive_order_number":null,"full_text_xml_url":"https://www.federalregister.gov/documents/full_text/xml/2026/08/25/2026-17329.xml","html_url":"https://www.federalregister.gov/documents/2026/08/25/2026-17329/30-day-notice-of-intent-to-seek-extension-of-approval-of-collection-recordations-rail-and-water","pdf_url":"https://www.govinfo.gov/content/pkg/FR-2026-08-25/pdf/2026-17329.pdf","publication_date":"2026-08-25","regulation_id_numbers":[],"signing_date":null,"start_page":54906,"subtype":null,"title":"30-Day Notice of Intent To Seek Extension of Approval of Collection: Recordations (Rail and Water Carrier Liens), Water Carrier Tariffs, and Agricultural Contract Summaries","topics":[],"type":"Notice","volume":91},{"abstract":"As required by the Paperwork Reduction Act of 1995 (PRA), the Surface Transportation Board (STB or Board) gives notice of its intent to seek approval from the Office of Management and Budget (OMB) for an extension of the collection of Arbitration \"Opt-in\" Notices, described below.","agencies":[{"raw_name":"SURFACE TRANSPORTATION BOARD","name":"Surface Transportation Board","id":481,"url":"https://www.federalregister.gov/agencies/surface-transportation-board","json_url":"https://www.federalregister.gov/api/v1/agencies/481","parent_id":null,"slug":"surface-transportation-board"}],"agency_names":["Surface Transportation Board"],"body_html_url":"https://www.federalregister.gov/documents/full_text/html/2026/08/25/2026-17328.html","cfr_references":[],"comments_close_on":"2026-09-24","docket_ids":[],"document_number":"2026-17328","effective_on":null,"end_page":54905,"executive_order_number":null,"full_text_xml_url":"https://www.federalregister.gov/documents/full_text/xml/2026/08/25/2026-17328.xml","html_url":"https://www.federalregister.gov/documents/2026/08/25/2026-17328/30-day-notice-of-intent-to-seek-extension-of-approval-of-collection-arbitration-opt-in-notices","pdf_url":"https://www.govinfo.gov/content/pkg/FR-2026-08-25/pdf/2026-17328.pdf","publication_date":"2026-08-25","regulation_id_numbers":[],"signing_date":null,"start_page":54904,"subtype":null,"title":"30-Day Notice of Intent To Seek Extension of Approval of Collection: Arbitration “Opt-In” Notices","topics":[],"type":"Notice","volume":91}]}