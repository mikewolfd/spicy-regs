  "unresolved_design_choices": [],
  "snapshot_model": "One accepted snapshot per scorecard in each family generation. All edition-scoped facts carry the selected snapshot_id. Previous snapshots survive in immutable prior generations, not as competing rows in the current generation. Publisher identity observations are independent.",
  "json_shapes": {
    "periods_json": "Ordered array of source period occurrences. Each object has occurrence_id, period_text, kind (explicit or relative), nullable source-stated year_text/congress_text/session_text/chamber_text, and source_path. A relative current/prior-six-session rule stays literal; no inferred endpoints. Metric periods may differ from edition periods.",
    "references_json": "Ordered array of references with occurrence_id, citation_text, kind, nullable source-stated congress_text/chamber_text/session_text/roll_number_text/bill_citation_text/amendment_citation_text, and source_path. Preserve repeated references; never inherit an edition Congress for an item without source evidence.",
    "capture_roles_json": "Ordered array of capture_id, role and field_groups. Every capture must belong to capture_ids_json. Declare one primary rendition for each field group; alternate displays remain validation evidence, not duplicate metric values.",
    "identifiers_json": "Ordered array of source-supplied identifier scheme and literal value. No derived identity belongs here."
  },
  "invariants": [
    "Keys contain nonempty strings; identities are unique before merge and versioned per adapter. Row offset alone is not durable identity.",
    "Exactly one accepted snapshot per edition in a family generation, every fact snapshot matches its edition, every fact capture belongs to its snapshot, and all references stay within the selected snapshot.",
    "Member-item metric_id and participation_id are both null or both nonempty. No metric is created merely to store an item result.",
    "Item-level targets require source-stated context and locator. Metric-specific targets live on metric participation; do not infer one from the other.",
    "Metric components form an acyclic directed graph. Primary metrics are scoped by chamber/cohort/period.",
    "Selected source rendition and identity rules are recorded per snapshot. Literal display values are not converted to agree with corroborating captures.",
    "Source action labels never imply an official action. Preserve publisher-specific semantic rules, including AFL-CIO no-means-signed letter encoding.",
    "Schema fit, acquisition completeness, parser qualification and reproduction readiness are independent statuses.",
    "Rolling editions use a source-defined live edition identity; refresh changes snapshot. Relative windows remain literal until publisher endpoints are supplied."
  ],
  "deferred_source_tables": [
    {
      "name": "scorecard_member_adjustments",
