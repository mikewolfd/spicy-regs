{"data": {"id": "ACF-2009-0004-0002", "type": "comments", "links": {"self": "https://api.regulations.gov/v4/comments/ACF-2009-0004-0002"}, "attributes": {"commentOn": "09000064808e8021", "commentOnDocumentId": "ACF-2009-0004-0001", "duplicateComments": 0, "address1": null, "address2": null, "agencyId": "ACF", "city": null, "category": null, "comment": "Dear Ms. Riddick:<br/><br/><span style='padding-left: 30px'></span>In response to the Department of Health and Human Service&rsquo;s request <br/>for public comment published in the Federal Register (74 FR 9171) on March 3, <br/>2009, the Florida Department of Revenue, Child Support Enforcement Program <br/>supports a 60-day delay in the effective date of the rule entitled &quot;State Parent <br/>Locator Service; Safeguarding Child Support Information&quot;.  The delay will provide <br/>additional time to implement the new requirements.  <br/><br/><span style='padding-left: 30px'></span>Thank you for allowing the opportunity to comment.<br/><br/>Sincerely,<br/><br/>Ann Coffin<br/>Program Director<br/>Child Support Enforcement<br/>", "country": null, "displayProperties": [{"name": "pageCount", "label": "Page Count", "tooltip": "Number of pages In the content file"}], "docAbstract": null, "docketId": "ACF-2009-0004", "documentType": "Public Submission", "email": null, "fax": null, "field1": null, "field2": null, "fileFormats": null, "firstName": "ANN", "govAgency": null, "govAgencyType": null, "objectId": "0900006480904f28", "lastName": "COFFIN, DIRECTOR", "legacyId": null, "modifyDate": "2009-03-11T16:44:09Z", "organization": "FLORIDA DEPARTMENT OF REVENUE, CSE", "originalDocumentId": "", "pageCount": 0, "phone": null, "postedDate": "2009-03-11T04:00:00Z", "postmarkDate": null, "reasonWithdrawn": null, "receiveDate": "2009-03-11T15:44:08Z", "restrictReason": null, "restrictReasonType": null, "stateProvinceRegion": null, "submitterRep": null, "submitterRepAddress": null, "submitterRepCityState": null, "subtype": null, "