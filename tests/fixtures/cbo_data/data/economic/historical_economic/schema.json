{
  "dataset": "historical_economic",
  "publication_id": "55022",
  "title": "Historical Data and Economic Projections",
  "source_url": "https://www.cbo.gov/publication/55022",
  "description": "Data on output, prices, labor market measures, interest rates, income, potential GDP, and its underlying inputs from 1949 through the most recent year completed, plus CBO projections.",
  "frequency": "quarterly",
  "date_format": "YYYYqN (e.g., 1949q1, 2026q4)",
  "canonical_columns": ["date", "variable", "value"],
  "annual_derivation": {
    "calendar_year": "Average of Q1-Q4 in the same calendar year",
    "fiscal_year": "Average of Q4 of prior CY + Q1-Q3 of labeled FY year (Oct-Sep)"
  },
  "fields": {
    "gdp": {
      "description": "Gross Domestic Product",
      "unit": "SAAR, billions_of_dollars",
      "aggregation": "mean",
      "source_frequency": "quarterly",
      "category": "output"
    },
    "gnp": {
      "description": "Gross National Product",
      "unit": "SAAR, billions_of_dollars",
      "aggregation": "mean",
      "source_frequency": "quarterly",
      "category": "output"
    },
    "potential_gdp": {
      "description": "Nominal Potential Gross Domestic Product",
      "unit": "billions_of_dollars",
      "aggregation": "mean",
      "source_frequency": "quarterly",
      "category": "output"
    },
    "real_gdp": {
      "description": "Real Gross Domestic Product",
      "unit": "SAAR, Bil.Chn.2017.$",
      "aggregation": "mean",
      "source_frequency": "quarterly",
