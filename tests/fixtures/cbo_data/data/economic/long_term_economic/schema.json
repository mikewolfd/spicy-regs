{
  "dataset": "long_term_economic",
  "publication_id": "57054",
  "title": "Long-Term Economic Projections",
  "source_url": "https://www.cbo.gov/publication/57054",
  "description": "Extensions of CBO's 10-year economic projections for additional decades, covering GDP growth, labor force, productivity, inflation, interest rates, and key economic levels out to ~2055-2100.",
  "frequency": "annual",
  "date_format": "YYYY (4-digit year)",
  "canonical_columns": ["date", "variable", "value"],
  "output_files": {
    "rates_{vintage}.csv": "Annual growth rates and percentages (Sheet 1)",
    "lfp_rates_{vintage}.csv": "Labor force participation rates by sex and age group (Sheet 2)",
    "levels_{vintage}.csv": "Annual level variables — GDP, prices, labor force (Sheet 3)"
  },
  "rates_fields": {
    "real_potential_gdp_growth": {"description": "Growth of real potential GDP", "unit": "Percent"},
    "potential_lf_growth": {"description": "Growth of potential labor force", "unit": "Percent"},
    "potential_lf_prod_growth": {"description": "Growth of potential labor force productivity", "unit": "Percent"},
    "real_gdp_growth": {"description": "Growth of real GDP", "unit": "Percent"},
    "real_gdp_per_person_growth": {"description": "Growth of real GDP per person", "unit": "Percent"},
    "nominal_gdp_growth": {"description": "Growth of nominal GDP", "unit": "Percent"},
    "lfpr": {"description": "Labor force participation rate (BLS basis)", "unit": "Percent"},
    "lfpr_census": {"description": "Labor force participation rate (Census basis)", "unit": "Percent"},
    "labor_force_growth": {"description": "Labor force growth (BLS basis)", "unit": "Percent"},
    "labor_force_growth_census": {"description": "Labor force growth (Census basis)", "unit": "Percent"},
    "unemployment_rate": {"description": "Unemployment rate", "unit": "Percent"},
    "noncyclical_unemp_rate": {"description": "Noncyclical rate of unemployment", "unit": "Percent"},
    "avg_hours_worked_growth": {"description": "Growth of average hours worked", "unit": "Percent"},
    "total_hours_worked_growth": {"description": "Growth of total hours worked", "unit": "Percent"},
    "earnings_share_of_comp": {"description": "Earnings as a share of compensation", "unit": "Percent"},
    "real_earnings_per_worker_growth": {"description": "Growth of real earnings per worker", "unit": "Percent"},
    "earnings_below_taxable_max_share": {"description": "Share of earnings below the taxable maximum", "unit": "Percent"},
    "tfp_growth": {"description": "Growth of total factor productivity", "unit": "Percent"},
    "real_gdp_per_hour_growth": {"description": "Growth of real GDP per hour worked", "unit": "Percent"},
    "pce_price_growth": {"description": "Growth of the PCE price index", "unit": "Percent"},
    "cpiu_growth": {"description": "Growth of the CPI-U", "unit": "Percent"},
    "gdp_price_growth": {"description": "Growth of the GDP price index", "unit": "Percent"},
    "treasury_10y_real": {"description": "Real interest rate on 10-year Treasury notes", "unit": "Percent"},
    "treasury_10y_nominal": {"description": "Nominal interest rate on 10-year Treasury notes", "unit": "Percent"},
    "interest_rate_fed_debt": {"description": "Interest rate on all federal debt held by the public (FY)", "unit": "Percent"},
    "population": {"description": "Population", "unit": "Millions of people"}
  },
  "lfp_rates_format": {
    "description": "Labor force participation rates by sex and age group, stored in tidy format",
    "columns": ["year", "sex", "age_group", "lfp_rate"],
    "sex_values": ["all", "male", "female"],
    "age_groups": "16+, 16-17, 18-19, 20-24, ..., 70-79, 80-89 (33 groups total)"
  },
  "levels_fields": {
    "real_gdp_level": {"description": "Real GDP", "unit": "Trillions of 2017 dollars"},
    "nominal_gdp_level": {"description": "Nominal GDP", "unit": "Trillions of dollars"},
    "real_potential_gdp_level": {"description": "Real Potential GDP", "unit": "Trillions of 2017 dollars"},
    "gdp_price_index_level": {"description": "GDP price index", "unit": "Index, 2017=1.0"},
    "pce_price_index_level": {"description": "PCE price index", "unit": "Index, 2017=1.0"},
    "cpiu_index_level": {"description": "CPI-U", "unit": "Index, 1982-84=1.0"},
    "wage_salary_level": {"description": "U.S. wage and salary disbursements", "unit": "Trillions of dollars"},
    "civilian_lf_level": {"description": "Civilian labor force (BLS basis)", "unit": "Millions of people"},
    "civilian_lf_level_census": {"description": "Civilian labor force (Census basis)", "unit": "Millions of people"},
    "civilian_empl_level": {"description": "Total civilian employment (BLS basis)", "unit": "Millions of people"},
    "civilian_empl_level_census": {"description": "Total civilian employment (Census basis)", "unit": "Millions of people"},
    "proprietors_income_level": {"description": "Proprietors' income", "unit": "Trillions of dollars"},
    "potential_lf_level": {"description": "Potential labor force", "unit": "Millions of people"}
  }
}
