{
  // Cloudflare Containers deploy for the MCP server. BETA (Containers is in beta
  // as of 2026) — verify field names against the installed wrangler on first
  // deploy. standard-4 = 4 vCPU / 12 GiB RAM / 20 GB real disk: the disk is why
  // this is a better heavy-analytics fit than Cloud Run's RAM-backed /tmp, since
  // DuckDB can spill big aggregations to it (SPICY_REGS_TEMP_DIR=/tmp).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spicy-regs-mcp",
  "account_id": "174055408ff1560e60601c4d12c561c4",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // The fork serves MCP at the custom domain and its workers.dev address.
  // Per-version preview URLs would add unlisted public copies of the server.
  "workers_dev": true,
  "routes": [{ "pattern": "mcp.spicygov.ai", "custom_domain": true }],
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  // Set these for the selected account before deploying a fork. The Worker
  // forwards them to Python; secrets belong in Wrangler's secret store.
  "vars": {
    "SPICY_REGS_R2_URL": "https://data.spicygov.ai",
    // Set these to the admitted release receipt and actual deployed image pins.
    // Empty values keep qualified FEC views disabled until release acceptance.
    "SPICY_REGS_FEC_RELEASE_SHA256": "sha256:d4dbd1c1dcbcc3805d891066bcc3b36e63fbd2642ab30d3916631c69a96a5873",
    "SPICY_REGS_CONSUMER_IMAGE_DIGEST": "sha256:22b26fb1dc1a32846e20eaf4ed4dd3a1efa216ca0660702c20197b4c993ca566",
    "R2_CATALOG_URI": "",
    "R2_CATALOG_WAREHOUSE": "",
    "R2_CATALOG_NAMESPACE": "default"
  },
  "containers": [
    {
      "class_name": "McpContainer",
      // Build and push Dockerfile from the repo root before binding a new release.
      // Deploy the measured image digest so the receipt and runtime stay matched.
      "image": "registry.cloudflare.com/174055408ff1560e60601c4d12c561c4/spicy-regs-fec@sha256:22b26fb1dc1a32846e20eaf4ed4dd3a1efa216ca0660702c20197b4c993ca566",
      "image_build_context": "../../",
      "instance_type": "standard-4",
      "max_instances": 10
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "MCP_CONTAINER", "class_name": "McpContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["McpContainer"] }]
}
