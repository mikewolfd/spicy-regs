# R2 configuration for this fork's Cloudflare account (see deploy/fork-setup.md).
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=spicy-regs
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://data.example.org
# CLI, analytics and MCP use R2_PUBLIC_URL unless this read-only override is set.
# SPICY_REGS_R2_URL=https://data.example.org

# Cloudflare edge-cache purge — invalidate the selected data hostname after publish.
# Optional: unset => purge is a no-op (uploads still work). Both must be set to
# enable it. Token needs Zone > Cache Purge (edit) on the selected domain's zone;
# zone id is on the Cloudflare dashboard overview for that zone.
# CLOUDFLARE_API_TOKEN=your_cache_purge_token
# CLOUDFLARE_ZONE_ID=your_zone_id

# Account selection for Wrangler deployment. Match the R2 endpoint account.
# Keep a deploy-scoped Cloudflare token separate from the optional purge token.
CLOUDFLARE_ACCOUNT_ID=your_account_id

# R2 Data Catalog (Apache Iceberg) — only needed for `run-pipeline --use-iceberg`.
# URI + warehouse are under R2 > your bucket > Settings > Data Catalog.
# The token must be an R2 API token with both R2 and data-catalog permissions.
# R2_CATALOG_URI=https://catalog.cloudflarestorage.com/YOUR_ACCOUNT_ID/spicy-regs
# R2_CATALOG_WAREHOUSE=YOUR_ACCOUNT_ID_spicy-regs
# R2_CATALOG_TOKEN=your_data_catalog_api_token
# R2_CATALOG_NAMESPACE=default

# Optional: Limit agencies for testing
# AGENCIES=EPA,DOL,HHS
